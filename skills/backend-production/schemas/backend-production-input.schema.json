{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backend Production Skill Input",
  "type": "object",
  "required": ["project", "frontend_handoff", "asset_plan", "shot_plan", "style_risk", "style_contract"],
  "properties": {
    "normalization": {
      "type": "object",
      "properties": {
        "input_quality": {
          "type": "string",
          "enum": ["standard", "usable_but_incomplete", "vague", "blocked"]
        },
        "inferred_fields": { "type": "array", "items": { "type": "string" } },
        "missing_fields": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "needs_model_completion": { "type": "boolean" },
        "user_questions": { "type": "array", "items": { "type": "string" } },
        "handoff_ready": { "type": "boolean" }
      }
    },
    "project": {
      "type": "object",
      "required": ["project_name", "segment_id", "runtime", "aspect_ratio", "target_model"],
      "properties": {
        "project_name": { "type": "string" },
        "segment_id": { "type": "string" },
        "runtime": { "type": "string" },
        "aspect_ratio": { "type": "string" },
        "target_model": { "type": "string", "const": "Seedance 2.0" }
      }
    },
    "frontend_handoff": {
      "type": "object",
      "required": ["story_function", "shot_count", "storyboard_layout", "in_state", "action_chain", "out_state"],
      "properties": {
        "story_function": { "type": "string" },
        "shot_count": { "type": "integer", "minimum": 1 },
        "storyboard_layout": { "type": "string" },
        "continuity_mode": { "type": "string" },
        "in_state": { "type": "string" },
        "action_chain": { "type": "string" },
        "out_state": { "type": "string" },
        "continuity_to_next": { "type": "string" }
      }
    },
    "asset_plan": {
      "type": "object",
      "properties": {
        "character_assets": { "type": "array", "items": { "type": "string" } },
        "scene_assets": { "type": "array", "items": { "type": "string" } },
        "prop_assets": { "type": "array", "items": { "type": "string" } },
        "user_uploaded_assets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "shot_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "timecode", "shot_size", "composition", "action_state", "camera_movement", "action_direction", "cut_function", "active_assets"],
        "properties": {
          "shot_id": { "type": "string" },
          "timecode": { "type": "string" },
          "shot_size": { "type": "string" },
          "composition": { "type": "string" },
          "action_state": { "type": "string" },
          "camera_movement": { "type": "string" },
          "action_direction": { "type": "string" },
          "cut_function": { "type": "string" },
          "active_assets": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "style_risk": {
      "type": "object",
      "properties": {
        "likely_drift": { "type": "array", "items": { "type": "string" } },
        "likely_contamination": { "type": "array", "items": { "type": "string" } },
        "likely_missing_shots": { "type": "array", "items": { "type": "string" } },
        "final_frame_risk": { "type": "array", "items": { "type": "string" } }
      }
    },
    "style_contract": {
      "type": "object",
      "required": [
        "source_style_evidence",
        "render_style",
        "medium",
        "realism_level",
        "material_finish",
        "lighting_language",
        "lens_language",
        "color_palette",
        "forbidden_styles",
        "style_source"
      ],
      "properties": {
        "source_style_evidence": { "type": "string" },
        "render_style": { "type": "string" },
        "medium": { "type": "string" },
        "realism_level": { "type": "string" },
        "material_finish": { "type": "string" },
        "lighting_language": { "type": "string" },
        "lens_language": { "type": "string" },
        "color_palette": { "type": "string" },
        "forbidden_styles": { "type": "array", "items": { "type": "string" } },
        "style_source": {
          "type": "string",
          "enum": ["explicit", "inferred_from_assets", "inferred_from_reference", "needs_user"]
        }
      }
    }
  }
}
